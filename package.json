{
  "name": "autonomous-research-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous Research & Knowledge Assistant - Windows desktop app powered by a local Ollama model.",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rka/desktop dev",
    "build": "pnpm --filter @rka/desktop build",
    "preview": "pnpm --filter @rka/desktop preview",
    "package:win": "pnpm --filter @rka/desktop package:win",
    "package:dir": "pnpm --filter @rka/desktop package:dir",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ollama": "pnpm --filter @rka/model-provider test:live",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1"
  }
}
