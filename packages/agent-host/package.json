{
  "name": "@rka/agent-host",
  "version": "0.0.0",
  "private": true,
  "description": "Electron-agnostic agent host composition layer (in-process; not a separate process). Sits above @rka/agent-runtime and @rka/adk-runtime; OS capabilities are injected through HostPorts.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rka/adk-runtime": "workspace:*",
    "@rka/agent-runtime": "workspace:*",
    "@rka/model-provider": "workspace:*",
    "@rka/shared": "workspace:*",
    "@rka/storage": "workspace:*",
    "@rka/tools": "workspace:*"
  },
  "devDependencies": {
    "zod": "4.6.7"
  }
}
