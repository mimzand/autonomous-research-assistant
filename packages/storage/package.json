{
  "name": "@rka/storage",
  "version": "0.0.0",
  "private": true,
  "description": "SQLite persistence (better-sqlite3 + Drizzle ORM): migrations, typed repositories, task recovery.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "db:embed": "node scripts/embed-migrations.mjs"
  },
  "dependencies": {
    "@rka/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
