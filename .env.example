# Copy to .env (never commit .env). All values are local - no API keys are needed.
#
# The desktop app loads this file at startup in development.
# Real environment variables take precedence over values in .env.

# Ollama server address. Use 127.0.0.1, not "localhost": on Windows "localhost"
# can resolve to IPv6 ::1, where Ollama does not listen by default.
# Accepts "127.0.0.1:11434" or "http://127.0.0.1:11434".
OLLAMA_HOST=127.0.0.1:11434

# Local model used by the agent runtime. Must support tool calling.
OLLAMA_MODEL=qwen3:8b

# Context window passed to Ollama. 4096 keeps ~70% of qwen3:8b on a 6 GB GPU;
# larger values move more layers to the CPU.
OLLAMA_NUM_CTX=4096

# Timeout (ms) for Ollama health checks and model lookups.
OLLAMA_REQUEST_TIMEOUT_MS=5000

# Deadline (ms) for a single (non-streaming) generation. The first call loads the
# model into memory, which takes ~30 s for qwen3:8b on a 6 GB GPU.
OLLAMA_GENERATE_TIMEOUT_MS=300000

# Streaming fails if no data arrives for this long (ms).
OLLAMA_STREAM_IDLE_TIMEOUT_MS=120000
