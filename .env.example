# Copy to .env (never commit .env). All values are local - no API keys are needed.
#
# The desktop app loads this file at startup in development.
# Real environment variables take precedence over values in .env.
#
# These values are only DEFAULTS. Everything here can also be changed while the app
# runs in Settings (saved in SQLite, and saved values win). See docs/settings.md.

# Ollama server address. Use 127.0.0.1, not "localhost": on Windows "localhost"
# can resolve to IPv6 ::1, where Ollama does not listen by default.
# Accepts "127.0.0.1:11434" or "http://127.0.0.1:11434".
OLLAMA_HOST=127.0.0.1:11434

# Local model used by the agent runtime. Must support tool calling.
OLLAMA_MODEL=qwen3:8b

# Context window passed to Ollama. 4096 keeps ~70% of qwen3:8b on a 6 GB GPU;
# larger values move more layers to the CPU.
OLLAMA_NUM_CTX=4096

# Timeout (ms) for Ollama health checks and model lookups.
OLLAMA_REQUEST_TIMEOUT_MS=5000

# Deadline (ms) for a single (non-streaming) generation. The first call loads the
# model into memory, which takes ~30 s for qwen3:8b on a 6 GB GPU.
OLLAMA_GENERATE_TIMEOUT_MS=300000

# Streaming fails if no data arrives for this long (ms).
OLLAMA_STREAM_IDLE_TIMEOUT_MS=120000

# --- Web research ------------------------------------------------------------
# Web search uses SearXNG, a free, self-hosted metasearch engine (no API key).
# Leave empty to disable web search. Example with Docker:
#   docker run -d -p 127.0.0.1:8080:8080 searxng/searxng
# and enable JSON output in its settings.yml:  search: formats: [html, json]
# This is the ONLY private address the app will contact; page fetching is
# limited to public internet addresses.
SEARXNG_URL=http://127.0.0.1:8080

# SearXNG safe search: 0 off, 1 moderate, 2 strict.
SEARXNG_SAFESEARCH=1

# Deadline (ms) for downloading one page, including redirects.
WEB_FETCH_TIMEOUT_MS=20000

# Deadline (ms) for one search request.
WEB_SEARCH_TIMEOUT_MS=15000

# Largest download accepted (bytes, max 52428800). Larger pages are refused.
WEB_MAX_DOWNLOAD_BYTES=15728640

# --- Research task reliability -------------------------------------------------
# Defaults for new research tasks (each task stores its own copy). Leave empty
# for the built-in default. Invalid values stop the app at startup.

# Extra attempts after a failed model call (invalid JSON, timeout, server error). 0-3, default 1.
RESEARCH_MODEL_RETRIES=
# Extra attempts after a transient tool failure (timeout, network, HTTP 5xx). 0-3, default 1.
RESEARCH_TOOL_RETRIES=
# First retry delay in ms; doubles on each attempt (max 30 s). 0-60000, default 1000.
RESEARCH_RETRY_BACKOFF_MS=
# Deadline for one model call in ms. 1000-900000, default 300000.
RESEARCH_MODEL_TIMEOUT_MS=
# Sub-questions per plan (1-6, default 3) and sources read per task (1-12, default 6).
RESEARCH_MAX_QUESTIONS=
RESEARCH_MAX_SOURCES=
