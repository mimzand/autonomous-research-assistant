{
  "name": "@rka/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone agent service: serves @rka/agent-protocol on 127.0.0.1. Runs without Electron.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "ping": "tsx src/ping.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rka/agent-client": "workspace:*",
    "@rka/agent-host": "workspace:*",
    "@rka/agent-protocol": "workspace:*",
    "@rka/agent-runtime": "workspace:*",
    "@rka/model-provider": "workspace:*",
    "@rka/shared": "workspace:*",
    "@rka/storage": "workspace:*",
    "@rka/tools": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
