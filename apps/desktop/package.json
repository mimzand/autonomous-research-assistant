    "@rka/shared": "workspace:*",
    "@rka/storage": "workspace:*",
    "@rka/tools": "workspace:*",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.10.1",
    "electron-vite": "6.0.0",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14",
    "zod": "4.6.7"
  }
}
