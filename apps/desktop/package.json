{
  "name": "@rka/desktop",
  "productName": "Autonomous Research Assistant",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell: main process, preload bridge and Vue renderer.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
